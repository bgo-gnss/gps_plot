[Unit]
OnFailure=yang-notify@%n.service
Description=gpsplot rtk-run, long plots every 30 min, without 7d-along

[Service]
ExecStartPost=%h/src/gps_plot/deployment/yang/yang-notify.py ok %n
Type=oneshot
Nice=10
EnvironmentFile=%h/src/gps_plot/deployment/yang/yang.env
WorkingDirectory=/mnt/data/gpsops
ExecStart=/mnt/data/gpsops/venv/bin/gpsplot rtk-run --area svinafellsheidi,reykjanes,seydisfjordur,vatnsfell,karahnjukar --run 4d,7d,14d --plots-dir /mnt/data/gpsops/plots
TimeoutStartSec=15min
