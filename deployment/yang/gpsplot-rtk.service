[Unit]
OnFailure=yang-notify@%n.service
Description=gpsplot rtk-run, short plots every 5 min

[Service]
ExecStartPost=%h/src/gps_plot/deployment/yang/yang-notify.py ok %n
Type=oneshot
Nice=10
EnvironmentFile=%h/src/gps_plot/deployment/yang/yang.env
WorkingDirectory=/mnt/data/gpsops
ExecStart=/mnt/data/gpsops/venv/bin/gpsplot rtk-run --area svinafellsheidi,reykjanes,seydisfjordur,vatnsfell,karahnjukar --run 6h,12h,2d --plots-dir /mnt/data/gpsops/plots
TimeoutStartSec=15min
