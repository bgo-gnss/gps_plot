[Unit]
Description=gpsplot on yang: new days from okada, plots when changed

[Service]
Type=oneshot
Nice=10
EnvironmentFile=%h/src/gps_plot/deployment/yang/yang.env
WorkingDirectory=/mnt/data/gpsops
ExecStart=/usr/bin/flock -w 3600 %t/gpsplot-run.lock %h/src/gps_plot/deployment/yang/yang-plots.sh --changed
TimeoutStartSec=6h
