# yang-d01 runtime environment: EnvironmentFile= of every unit, sourced by the
# scripts run by hand. Plain KEY=value, no shell expansion. Everything is under
# /mnt/data (/ has 2.7 GB free, /home 5 GB), caches included.
YANG_ROOT=/mnt/data/gpsops
PATH=/mnt/data/gpsops/venv/bin:/mnt/data/gpsops/bin:/usr/local/bin:/usr/bin:/bin
GPS_CONFIG_PATH=/mnt/data/gpsops/config
GPS_API_STORE=/mnt/data/gpsops/cache/gps_analysis
GG_TABLES=/mnt/data/gpsops/gg/tables
XDG_CACHE_HOME=/mnt/data/gpsops/cache
MPLCONFIGDIR=/mnt/data/gpsops/cache/matplotlib
UV_CACHE_DIR=/mnt/data/gpsops/cache/uv
UV_PYTHON_INSTALL_DIR=/mnt/data/gpsops/python
PYTHONNOUSERSITE=1
LC_ALL=C.UTF-8
